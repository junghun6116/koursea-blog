---
interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
  date: Date;
  image?: string;
  imageAlt?: string;
  featured?: boolean;
}

const { href, title, description, label, date, image, imageAlt = '', featured = false } = Astro.props;
---

<article class:list={['guide-card', { 'guide-card--featured': featured, 'guide-card--with-image': image }] }>
  {image && <a class="guide-card__image" href={href} aria-label={`Read ${title}`}>
    <img src={image} alt={imageAlt} width="1200" height="630" loading={featured ? 'eager' : 'lazy'} decoding="async" />
  </a>}
  <div class="guide-card__body">
    <div class="guide-card__meta"><span>{label}</span><time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="guide-card__read" href={href}>Read guide <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .guide-card{display:flex;min-width:0;min-height:300px;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow-sm)}
  .guide-card__image{display:block;overflow:hidden;aspect-ratio:16/9;background:var(--ink)}
  .guide-card__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .guide-card__image:hover img{transform:scale(1.025)}
  .guide-card__body{display:flex;min-width:0;flex:1;flex-direction:column;padding:22px}
  .guide-card__meta{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted);font-size:.68rem;letter-spacing:.045em;text-transform:uppercase}
  .guide-card__meta span{color:var(--teal);font-weight:850}
  .guide-card h3{margin:1.25rem 0 .65rem;font:700 clamp(1.35rem,2.4vw,1.9rem)/1.08 var(--font-display);letter-spacing:-.03em}
  .guide-card h3 a{text-decoration:none}
  .guide-card p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.55}
  .guide-card__read{display:flex;justify-content:space-between;margin-top:auto;padding-top:1.35rem;color:var(--ink);font-size:.76rem;font-weight:850;text-decoration:none}
  .guide-card__read span{color:var(--teal)}
  .guide-card--featured{grid-column:span 2;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);min-height:390px}
  .guide-card--featured .guide-card__image{height:100%;aspect-ratio:auto}
  .guide-card--featured .guide-card__body{padding:30px}
  .guide-card--featured h3{font-size:clamp(2rem,3.8vw,3.15rem)}
  @media(max-width:760px){.guide-card{min-height:0}.guide-card--featured{grid-column:auto;display:flex;min-height:0}.guide-card--featured .guide-card__image{aspect-ratio:16/9}.guide-card--featured .guide-card__body{padding:22px}}
</style>
