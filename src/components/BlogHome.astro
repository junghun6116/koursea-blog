---
import type { CollectionEntry } from 'astro:content';
import GuideCard from './GuideCard.astro';

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
const bySlug = new Map(posts.map((post) => [post.id, post]));
const featured = bySlug.get('kgma-mma-2026-gocheok-sky-dome-seoul-trip-guide') ?? posts.find((post) => post.data.coverImage) ?? posts[0];
const featuredHeadline = featured.id === 'kgma-mma-2026-gocheok-sky-dome-seoul-trip-guide'
  ? 'Two award shows. One Seoul base.'
  : featured.data.title;
const leadStories = [bySlug.get('hybe-yongsan-1-day-tour-guide'), bySlug.get('olive-young-guide-foreign-travelers'), bySlug.get('first-24-hours-in-seoul-survival-guide')].filter(Boolean) as CollectionEntry<'posts'>[];
const latest = posts.filter((post) => post.id !== featured.id && !leadStories.some((story) => story.id === post.id)).slice(0, 6);
const coverAlt = (post: CollectionEntry<'posts'>) => post.data.coverImageAlt ?? `${post.data.title} guide cover`;
const labelFor = (post: CollectionEntry<'posts'>) => post.data.category ?? post.data.tags[0] ?? 'Korea guide';
const countMatching = (pattern: RegExp) => posts.filter((post) => pattern.test(`${post.data.title} ${post.data.tags.join(' ')}`)).length;
const lanes = [
  { href: '/category/kpop/', number: '01', title: 'K-Pop & concerts', copy: 'Venue logistics, official fan stops, merch checks and routes that still work after the encore.', count: countMatching(/k-?pop|concert|fan guide|fandom|bts|hybe|jyp|\bsm\b|\byg\b/i) },
  { href: '/category/travel/', number: '02', title: 'Travel essentials', copy: 'Arrival, transit, payments, neighborhoods and day trips with the details that change on the ground.', count: countMatching(/travel|airport|subway|transit|payment|cafe|restaurant|attraction|day trip/i) },
  { href: '/category/healthcare/', number: '03', title: 'K-Beauty planning', copy: 'Shopping, treatment research and clinic logistics for visitors who want the facts before they book.', count: countMatching(/beauty|skin|clinic|olive young|treatment|procedure/i) }
];
---

<div class="blog-home">
  <section class="hero shell">
    <div class="hero__copy"><p class="section-label">KOURSEA JOURNAL</p><h1>Korea trips,<br /><em>properly planned.</em></h1><p>Independent English guides for concert nights, neighborhood days and the details that decide whether a trip runs smoothly.</p><div class="hero__actions"><a href="/category/kpop/">Explore K-Pop travel</a><a href="/category/">Browse all topics</a></div></div>
    <a class="hero__story" href={`/posts/${featured.id}/`}>
      {featured.data.coverImage && <img src={featured.data.coverImage} alt={coverAlt(featured)} width="1200" height="630" fetchpriority="high" decoding="async" />}
      <span><small>K-POP &amp; CONCERTS</small><strong>{featuredHeadline}</strong><b>{featured.data.title} →</b></span>
    </a>
  </section>

  <section class="topic-lanes shell" aria-labelledby="topic-heading"><div class="section-heading"><p>CHOOSE A STARTING POINT</p><h2 id="topic-heading">What are you planning?</h2></div><div class="topic-lanes__grid">{lanes.map((lane) => <a href={lane.href}><span>{lane.number}</span><div><strong>{lane.title}</strong><p>{lane.copy}</p><small>{lane.count} guides →</small></div></a>)}</div></section>

  <section class="editor-picks shell" aria-labelledby="picks-heading"><div class="section-heading section-heading--row"><div><p>EDITOR'S ROUTES</p><h2 id="picks-heading">Three useful ways into Korea</h2></div><a href="/category/">See every category →</a></div><div class="picks-grid">{leadStories.map((post) => <GuideCard href={`/posts/${post.id}/`} title={post.data.title} description={post.data.description} label={labelFor(post)} date={post.data.updatedDate ?? post.data.pubDate} image={post.data.coverImage} imageAlt={coverAlt(post)} />)}</div></section>

  <section class="latest shell" aria-labelledby="latest-heading-new"><div class="section-heading section-heading--row"><div><p>RECENTLY UPDATED</p><h2 id="latest-heading-new">Fresh checks and field notes</h2></div><a href="/category/">Open the guide library →</a></div><div class="latest-grid">{latest.map((post) => <GuideCard href={`/posts/${post.id}/`} title={post.data.title} description={post.data.description} label={labelFor(post)} date={post.data.updatedDate ?? post.data.pubDate} image={post.data.coverImage} imageAlt={coverAlt(post)} />)}</div></section>

  <section class="bridge shell" aria-labelledby="bridge-heading"><div><p>CONTINUE ON KOURSEA</p><h2 id="bridge-heading">Turn the reading into a real route.</h2><span>Search source-linked places, save stops and ask travelers who know Korea.</span></div><nav aria-label="Koursea planning tools"><a href="https://www.koursea.com/kpop.html">Plan a K-Pop trip ↗</a><a href="https://www.koursea.com/places.html">Find places ↗</a><a href="https://www.koursea.com/community.html">Ask the community ↗</a></nav></section>

  <section class="standards shell" aria-label="Koursea editorial standards"><strong>How we work</strong><p>Changing details are checked against named sources. Photo credits stay visible. Sponsored links are labeled, and editorial rankings are not sold.</p><a href="/about/">Read our editorial standards →</a></section>
</div>

<style>
  .section-label,.section-heading>p,.section-heading>div>p,.bridge>div>p{margin:0;color:var(--teal);font-size:.68rem;font-weight:900;letter-spacing:.15em}.hero{display:grid;grid-template-columns:minmax(0,.85fr) minmax(460px,1.15fr);gap:52px;align-items:center;padding:58px 0 74px}.hero__copy h1{margin:.7rem 0 1.15rem;font:750 clamp(3.4rem,6.6vw,6.6rem)/.86 var(--font-display);letter-spacing:-.065em}.hero__copy h1 em{color:var(--teal);font-weight:500}.hero__copy>p:not(.section-label){max-width:570px;margin:0;color:var(--muted);font-size:1.03rem;line-height:1.65}.hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:1.7rem}.hero__actions a{display:inline-flex;min-height:46px;align-items:center;padding:10px 16px;border:1px solid var(--ink);border-radius:999px;font-size:.78rem;font-weight:850;text-decoration:none}.hero__actions a:first-child{background:var(--ink);color:#fff}.hero__story{position:relative;display:block;min-height:510px;overflow:hidden;border-radius:4px 48px 4px 4px;background:var(--ink);color:#fff;text-decoration:none;box-shadow:var(--shadow)}.hero__story:after{position:absolute;inset:25% 0 0;content:"";background:linear-gradient(transparent,rgba(8,18,25,.92))}.hero__story img{position:absolute;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.hero__story:hover img{transform:scale(1.02)}.hero__story>span{position:absolute;z-index:1;right:32px;bottom:30px;left:32px;display:grid;gap:10px}.hero__story small{font-size:.68rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.hero__story strong{max-width:18ch;font:700 clamp(1.8rem,3.4vw,3rem)/1.02 var(--font-display)}.hero__story b{font-size:.74rem}
  .section-heading{margin-bottom:24px}.section-heading h2{margin:.35rem 0 0;font:700 clamp(2rem,4.3vw,3.7rem)/.98 var(--font-display);letter-spacing:-.045em}.section-heading--row{display:flex;align-items:end;justify-content:space-between;gap:24px}.section-heading--row>a{display:inline-flex;min-height:44px;align-items:center;color:var(--teal);font-size:.76rem;font-weight:850}.topic-lanes{padding:0 0 86px}.topic-lanes__grid{border-top:1px solid var(--ink)}.topic-lanes__grid>a{display:grid;grid-template-columns:72px minmax(0,1fr);gap:18px;padding:24px 0;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .2s ease}.topic-lanes__grid>a:hover{padding-left:10px}.topic-lanes__grid>a>span{color:var(--teal);font:700 1rem var(--font-display)}.topic-lanes__grid>a>div{display:grid;grid-template-columns:minmax(220px,.55fr) minmax(0,1fr) auto;gap:28px;align-items:center}.topic-lanes strong{font:700 clamp(1.45rem,2.7vw,2.2rem)/1.05 var(--font-display)}.topic-lanes p{margin:0;color:var(--muted);font-size:.9rem}.topic-lanes small{color:var(--teal);font-weight:850;white-space:nowrap}.editor-picks{padding-bottom:88px}.picks-grid,.latest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.latest{padding-bottom:88px}.bridge{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.7fr);gap:54px;margin-bottom:24px;padding:42px;border-radius:4px 34px 4px 4px;background:var(--ink);color:#fff}.bridge h2{max-width:13ch;margin:.45rem 0 1rem;font:700 clamp(2.1rem,4.5vw,4rem)/.95 var(--font-display);letter-spacing:-.04em}.bridge>div>span{color:#c5cbd3}.bridge nav{display:grid;align-content:center}.bridge nav a{display:flex;min-height:56px;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.2);font-weight:800;text-decoration:none}.bridge nav a:first-child{border-top:1px solid rgba(255,255,255,.2)}.standards{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:24px;align-items:center;padding:26px 0 0}.standards strong{font:700 1.25rem var(--font-display)}.standards p{margin:0;color:var(--muted);font-size:.85rem}.standards a{color:var(--teal);font-size:.75rem;font-weight:850;white-space:nowrap}
  @media(max-width:820px){.hero{grid-template-columns:1fr;gap:28px;padding:34px 0 54px}.hero__copy h1{font-size:clamp(3rem,13vw,5rem)}.hero__story{min-height:430px}.topic-lanes__grid>a>div{grid-template-columns:1fr;gap:8px}.picks-grid,.latest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bridge{grid-template-columns:1fr}.standards{grid-template-columns:1fr;gap:8px}}
  @media(max-width:560px){.hero__story{min-height:360px;border-radius:3px 32px 3px 3px}.hero__story>span{right:22px;bottom:22px;left:22px}.topic-lanes{padding-bottom:62px}.topic-lanes__grid>a{grid-template-columns:42px minmax(0,1fr)}.picks-grid,.latest-grid{grid-template-columns:1fr}.editor-picks,.latest{padding-bottom:64px}.section-heading--row{align-items:start;flex-direction:column;gap:8px}.bridge{gap:28px;padding:28px 22px}.standards{padding-top:12px}}
</style>
