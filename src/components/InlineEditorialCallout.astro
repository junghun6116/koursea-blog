---
interface MetadataItem {
  label: string;
  value: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  buttonText: string;
  href: string;
  metadata?: MetadataItem[];
}

const { badge, title, description, buttonText, href, metadata = [] } = Astro.props;
const external = /^https?:\/\//.test(href);
const normalizedButtonText = buttonText.replace(/\s*[→↗]\s*$/, '');
---

<aside class="inline-editorial-card" aria-label={badge}>
  <div class="inline-editorial-card__body">
    <span class="inline-editorial-card__badge">{badge}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    {metadata.length > 0 && <dl class="inline-editorial-card__metadata">
      {metadata.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>}
  </div>
  <a class="inline-editorial-card__action" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
    <span>{normalizedButtonText}</span>
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </a>
</aside>

<style>
  .inline-editorial-card{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin:2rem 0;padding:1.6rem;border:1px solid rgba(212,212,212,.8);border-radius:1rem;background:#f9f9fb}
  .inline-editorial-card__body{max-width:38rem}.inline-editorial-card__badge{display:inline-flex;padding:.25rem .65rem;border:1px solid rgba(163,163,163,.65);border-radius:999px;color:#525252;font-size:.625rem;font-weight:700;letter-spacing:.16em}
  .inline-editorial-card h3{margin:.9rem 0 .4rem;color:#171717;font-size:1.25rem;font-weight:650;line-height:1.35;letter-spacing:-.02em}.inline-editorial-card p{margin:0;color:#525252;font-size:.94rem;line-height:1.6}
  .inline-editorial-card__metadata{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;margin:1.1rem 0 0;padding-top:.9rem;border-top:1px solid rgba(212,212,212,.8)}.inline-editorial-card__metadata div{min-width:7.5rem}.inline-editorial-card dt{color:#737373;font-size:.625rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.inline-editorial-card dd{margin:.1rem 0 0;color:#262626;font-size:.875rem;font-weight:650}
  .inline-editorial-card__action{display:inline-flex;min-height:44px;flex:none;align-items:center;justify-content:center;gap:.5rem;padding:.65rem 1.1rem;border:1px solid #d4d4d4;border-radius:999px;background:#fff;color:#171717;font-size:.875rem;font-weight:700;text-decoration:none;transition:transform .2s,border-color .2s,background .2s}.inline-editorial-card__action:hover{transform:translateY(-1px);border-color:#a3a3a3;background:#f5f5f5}.inline-editorial-card__action:focus-visible{outline:2px solid #737373;outline-offset:3px}.inline-editorial-card__action svg{width:1rem;height:1rem;transition:transform .2s}.inline-editorial-card__action:hover svg{transform:translateX(2px)}
  :global([data-theme='dark']) .inline-editorial-card{border-color:#262626;background:rgba(23,23,23,.6)}:global([data-theme='dark']) .inline-editorial-card h3,:global([data-theme='dark']) .inline-editorial-card dd{color:#fafafa}:global([data-theme='dark']) .inline-editorial-card p,:global([data-theme='dark']) .inline-editorial-card dt,:global([data-theme='dark']) .inline-editorial-card__badge{color:#a3a3a3}:global([data-theme='dark']) .inline-editorial-card__action{border-color:#404040;background:rgba(10,10,10,.7);color:#f5f5f5}
  @media(max-width:600px){.inline-editorial-card{align-items:stretch;flex-direction:column;padding:1.25rem}.inline-editorial-card__action{align-self:flex-start}}
</style>
