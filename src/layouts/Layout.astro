---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  type = 'website',
  schema
} = Astro.props;
const socialImage = new URL('/og-default.svg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Koursea Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
    <!-- Google AdSense script slot: insert the approved publisher script here. -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href="/" aria-label="Koursea Blog home">Koursea<span>Journal</span></a>
        <nav aria-label="Primary navigation">
          <a href="/">Guides</a>
          <a href="/about/">About</a>
          <a class="service-link" href="https://www.koursea.com/">Explore Koursea ↗</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <div><a class="brand" href="/">Koursea<span>Journal</span></a><p>Independent, practical Korea travel guidance for international visitors.</p></div>
        <nav aria-label="Legal and information"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a></nav>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Koursea. Verify changing fares, hours and rules with official sources.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root{--ink:#17213b;--muted:#606b7b;--paper:#f8f6f0;--surface:#fff;--line:#dfe3e7;--teal:#1f685c;--teal-soft:#e1f0eb;--gold:#bc843c;--shadow:0 18px 50px rgba(23,33,59,.09);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper)}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:0;background:var(--paper);color:var(--ink);line-height:1.65}a{color:inherit}.shell{width:min(1120px,calc(100% - 40px));margin-inline:auto}.skip-link{position:fixed;z-index:99;left:12px;top:8px;padding:10px 14px;background:var(--ink);color:#fff;transform:translateY(-150%)}.skip-link:focus{transform:none}.site-header{position:sticky;z-index:20;top:0;border-bottom:1px solid rgba(23,33,59,.1);background:rgba(248,246,240,.92);backdrop-filter:blur(14px)}.nav{display:flex;min-height:72px;align-items:center;justify-content:space-between;gap:24px}.brand{font:800 21px/1 Georgia,serif;text-decoration:none}.brand span{display:block;margin-top:4px;color:var(--teal);font:800 9px/1.1 Inter,sans-serif;letter-spacing:.18em;text-transform:uppercase}.nav nav,.footer-grid nav{display:flex;align-items:center;gap:20px}.nav nav a,.footer-grid nav a{font-size:13px;font-weight:750;text-decoration:none}.service-link{padding:10px 14px;border-radius:999px;background:var(--ink);color:#fff}main{min-height:70vh}footer{margin-top:80px;padding:46px 0 24px;border-top:1px solid var(--line);background:#f0ede5}.footer-grid{display:flex;justify-content:space-between;gap:40px}.footer-grid p{max-width:500px;color:var(--muted);font-size:13px}.copyright{text-align:center;margin:40px 20px 0;color:var(--muted);font-size:11px}.page{width:min(840px,calc(100% - 40px));margin:0 auto;padding:76px 0}.page h1{max-width:18ch;margin:0 0 20px;font:700 clamp(2.4rem,7vw,4.8rem)/1.02 Georgia,serif;letter-spacing:-.045em}.page .lead{max-width:66ch;color:var(--muted);font-size:1.12rem}.prose{font-family:Georgia,"Times New Roman",serif;font-size:1.08rem}.prose h2,.prose h3{font-family:Inter,sans-serif;line-height:1.2;letter-spacing:-.02em}.prose h2{margin-top:2.6em;font-size:1.75rem}.prose h3{margin-top:2em;font-size:1.25rem}.prose a{color:var(--teal);text-decoration-thickness:1px;text-underline-offset:3px}.prose blockquote{margin:1.5rem 0;padding:18px 22px;border-left:4px solid var(--gold);background:#fff8e8}.prose table{width:100%;border-collapse:collapse;font-family:Inter,sans-serif;font-size:.88rem}.prose th,.prose td{padding:12px;border:1px solid var(--line);text-align:left;vertical-align:top}.prose th{background:var(--teal-soft)}.table-wrap{max-width:100%;overflow-x:auto}.tag-list{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none}.tag-list li{padding:6px 10px;border-radius:999px;background:var(--teal-soft);color:var(--teal);font-size:11px;font-weight:800}.article-meta{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0 30px;color:var(--muted);font-size:12px}.article-cta{margin-top:56px;padding:24px;border-radius:18px;background:var(--ink);color:#fff}.article-cta a{display:inline-flex;margin-top:9px;padding:10px 14px;border-radius:999px;background:#fff;color:var(--ink);font:800 13px Inter,sans-serif;text-decoration:none}@media(max-width:700px){.shell,.page{width:min(100% - 28px,840px)}.nav{min-height:62px}.nav nav{gap:10px}.nav nav>a:not(.service-link){display:none}.service-link{padding:9px 11px;font-size:11px}.page{padding:48px 0}.page h1{font-size:clamp(2.25rem,11vw,3.25rem)}.footer-grid{flex-direction:column}.footer-grid nav{align-items:flex-start;flex-direction:column;gap:12px}.prose{font-size:1rem}.prose h2{font-size:1.45rem}.prose table{min-width:640px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
<style is:global>
  .eyebrow{margin:0 0 .7rem;color:var(--teal);font-size:.78rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
  .prose{min-width:0;overflow-wrap:anywhere}
  .prose table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
</style>
