---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  hasBodyH1?: boolean;
  socialImage?: string;
}

const {
  title,
  description,
  canonicalUrl,
  pubDate,
  updatedDate = pubDate,
  author,
  tags,
  hasBodyH1 = false,
  socialImage = '/og-default.png'
} = Astro.props;

const absoluteImage = new URL(socialImage, Astro.site).href;
const publisherId = new URL('/#organization', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    '@id': publisherId,
    name: 'Koursea',
    url: 'https://www.koursea.com/',
    logo: { '@type': 'ImageObject', url: absoluteImage, width: 1200, height: 630 }
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  image: { '@type': 'ImageObject', url: absoluteImage, width: 1200, height: 630 },
  keywords: tags.join(', '),
  inLanguage: 'en'
};
---

<Layout title={`${title} | Koursea Blog`} description={description} canonicalUrl={canonicalUrl} type="article" schema={schema} socialImage={socialImage}>
  <article class="page">
    <header>
      <ul class="tag-list">{tags.map((tag) => <li>{tag}</li>)}</ul>
      {!hasBodyH1 && <h1>{title}</h1>}
      <p class="lead">{description}</p>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>Published {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        {updatedDate.valueOf() !== pubDate.valueOf() && <><span>·</span><time datetime={updatedDate.toISOString()}>Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></>}
        <span>·</span><span>{author}</span>
      </div>
    </header>
    <div class="prose"><slot /></div>
    <aside class="article-cta"><strong>Keep this guide with you in Korea.</strong><p>Use Koursea for source-checked places, Korean taxi cards and practical neighborhood routes.</p><a href="https://www.koursea.com/">Open Koursea ↗</a></aside>
  </article>
</Layout>
