---
import Layout from './Layout.astro';
import SocialEmbed from '../components/SocialEmbed.astro';
import InlineEditorialCallout from '../components/InlineEditorialCallout.astro';

type EditorialCallout = {
  badge: string;
  title: string;
  description: string;
  buttonText: string;
  href: string;
  metadata?: Array<{ label: string; value: string }>;
};

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  socialImage?: string;
  socialImageAlt?: string;
  coverImage?: string;
  wordCount: number;
  toc: Array<{ depth: number; slug: string; text: string }>;
  relatedGuides?: Array<{ href: string; title: string; eyebrow: string }>;
  socialEmbed?: { xUrl?: string; instagramUrl?: string; label?: string };
  faq?: Array<{ question: string; answer: string }>;
  editorialCallout?: EditorialCallout;
}

const {
  title,
  description,
  canonicalUrl,
  pubDate,
  updatedDate = pubDate,
  author,
  tags,
  socialImage = '/og-default.png',
  socialImageAlt = `${title} — Koursea Journal`,
  coverImage,
  wordCount,
  toc,
  relatedGuides = [],
  socialEmbed,
  faq = [],
  editorialCallout
} = Astro.props;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const isAuthenticityGuide = canonicalUrl.includes('/posts/how-to-spot-fake-k-pop-merch-seoul-guide/');
const contextText = `${title} ${tags.join(' ')}`.toLowerCase();
const genericFallback = { href: 'https://www.koursea.com/index.html#places', label: 'Explore verified places on Koursea' };
const mustKeepGenericFallback = /seoul-post-office-ems-international-shipping-guide|jongno-heritage-family-friendly-walking-route|digital-nomad-coworking-day-pass-seoul-guide|seoul-printing-document-copying-guide/.test(canonicalUrl);
const exploreContext = mustKeepGenericFallback
  ? genericFallback
  : /k-?pop|concert|bts|twice|stray kids|newjeans|seventeen|enhypen|aespa|hybe|jyp|\bsm\b|\byg\b|kspo|fandom/.test(contextText)
    ? { href: 'https://www.koursea.com/category-kpop-entertainment.html', label: 'Explore verified K-Pop and entertainment places' }
    : /healthcare|clinic|procedure|botox|filler|rejuran|ultherapy|shurink|medical|dermatology/.test(contextText)
      ? { href: 'https://www.koursea.com/category-healthcare.html', label: 'Explore healthcare and clinic listings' }
      : /cafe|coffee|bakery|restaurant|dining|food/.test(contextText)
        ? { href: 'https://www.koursea.com/category-cafes-dining.html', label: 'Explore verified cafes and dining places' }
        : /hongdae|yeonnam/.test(contextText)
          ? { href: 'https://www.koursea.com/area-hongdae-seoul-guide.html', label: 'Explore verified places in Hongdae and Yeonnam' }
          : /gangnam|sinsa|apgujeong|cheongdam/.test(contextText)
            ? { href: 'https://www.koursea.com/area-gangnam-seoul-guide.html', label: 'Explore verified places in Gangnam and Sinsa' }
            : /seongsu/.test(contextText)
              ? { href: 'https://www.koursea.com/area-seongsu-seoul-guide.html', label: 'Explore verified places in Seongsu' }
              : /myeongdong/.test(contextText)
                ? { href: 'https://www.koursea.com/area-myeongdong-seoul-guide.html', label: 'Explore verified places in Myeongdong' }
                : genericFallback;

const absoluteImage = new URL(socialImage, Astro.site).href;
const publisherId = new URL('/#organization', Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  url: canonicalUrl,
  headline: title,
  description,
  abstract: description,
  isAccessibleForFree: true,
  isPartOf: { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: 'Koursea Blog', url: new URL('/', Astro.site).href },
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    '@id': publisherId,
    name: 'Koursea',
    url: 'https://www.koursea.com/',
    logo: { '@type': 'ImageObject', url: absoluteImage, width: 1200, height: 630 }
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  image: { '@type': 'ImageObject', url: absoluteImage, width: 1200, height: 630 },
  keywords: tags.join(', '),
  inLanguage: 'en'
};
const schema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': [
    { ...articleSchema, '@context': undefined, '@type': ['Article', 'BlogPosting'] },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faq.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    }
  ]
} : articleSchema;
---

<Layout title={`${title} | Koursea Blog`} description={description} canonicalUrl={canonicalUrl} type="article" schema={schema} socialImage={socialImage} socialImageAlt={socialImageAlt}>
  <article class="page" data-authenticity-guide={isAuthenticityGuide ? 'true' : undefined}>
    <header>
      <nav class="post-breadcrumbs" aria-label="Breadcrumb"><a href="/">Journal</a><span aria-hidden="true">/</span><span>Guide</span></nav>
      <h1 class="post-title">{title}</h1>
      <ul class="tag-list">{tags.map((tag) => <li>{tag}</li>)}</ul>
      <p class="lead">{description}</p>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>Published {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        {updatedDate.valueOf() !== pubDate.valueOf() && <><span>·</span><time datetime={updatedDate.toISOString()}>Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></>}
        <span>·</span><span>{author}</span><span>·</span><span>{readingMinutes} min read</span>
      </div>
    </header>
    {coverImage && <figure class="article-cover">
      <img src={coverImage} alt={`${title} cover`} width="1672" height="941" loading="eager" decoding="async" fetchpriority="high" />
    </figure>}
    {socialEmbed && <SocialEmbed {...socialEmbed} />}
    {toc.length > 0 && <details class="article-toc">
      <summary>Table of Contents</summary>
      <nav aria-label="Table of contents"><ol>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
    </details>}
    <div class="prose"><slot /></div>
    {editorialCallout && <InlineEditorialCallout {...editorialCallout} />}
    {relatedGuides.length > 0 && <aside class="related-pseo" aria-labelledby="related-planning-guides">
      <div><p class="eyebrow">KEEP PLANNING</p><h2 id="related-planning-guides">Related practical guides</h2></div>
      <div class="related-pseo-grid">{relatedGuides.map((guide) => <a href={guide.href}><span>{guide.eyebrow}</span><strong>{guide.title}</strong><small>Open guide →</small></a>)}</div>
    </aside>}
    <aside class="article-cta" aria-label="Explore Koursea tools">
      <strong>Continue planning on Koursea</strong>
      <p>Search verified places, open metro tools and save practical stops without logging in.</p>
      <a href={exploreContext.href}>{exploreContext.label} — 3,846 verified spots ↗</a>
    </aside>
  </article>
  <script is:inline>
    (() => {
      if (!document.querySelector('[data-authenticity-guide="true"]')) return;
      const key = `koursea_authenticity_guide_view:${location.pathname}`;
      try { if (sessionStorage.getItem(key) === '1') return; } catch (_) {}
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'authenticity_guide_view', { content_path: location.pathname });
      try { sessionStorage.setItem(key, '1'); } catch (_) {}
    })();
  </script>
</Layout>

<style>
  .post-breadcrumbs{display:flex;gap:.45rem;align-items:center;margin:0 0 .8rem;color:var(--muted);font-size:.78rem;font-weight:750}.post-breadcrumbs a{color:var(--teal);text-decoration:none}.post-title{margin:.15rem 0 1rem}
  .article-toc{margin:1.5rem 0 2rem;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .article-cover{margin:0 0 2rem;overflow:hidden;border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.article-cover img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
  .article-toc summary{cursor:pointer;font-weight:850;list-style-position:inside}.article-toc ol{display:grid;gap:.45rem;margin:.9rem 0 0;padding-left:1.35rem}.article-toc li{padding-left:.15rem}.article-toc li.nested{margin-left:1rem;font-size:.92rem}.article-toc a{color:var(--teal);text-decoration-thickness:1px;text-underline-offset:3px}
  .related-pseo{margin-top:3.5rem;padding-top:2rem;border-top:1px solid var(--line)}.related-pseo h2{margin:.2rem 0 1.25rem;font:700 clamp(1.7rem,4vw,2.35rem)/1.05 Georgia,serif}.related-pseo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.related-pseo-grid a{display:flex;min-height:150px;flex-direction:column;padding:1.1rem;border:1px solid var(--line);border-radius:15px;background:var(--surface);text-decoration:none}.related-pseo-grid span{color:var(--teal);font-size:.68rem;font-weight:900;letter-spacing:.08em}.related-pseo-grid strong{margin:.55rem 0;font:700 1.08rem/1.2 Georgia,serif}.related-pseo-grid small{margin-top:auto;color:var(--teal);font-weight:800}
  @media(max-width:600px){.article-toc{padding:.9rem}.article-toc li.nested{margin-left:.45rem}.related-pseo-grid{grid-template-columns:1fr}.related-pseo-grid a{min-height:128px}}
</style>
