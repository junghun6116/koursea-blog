---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryMatchers = {
  kpop: ['kpop', 'concert-tickets', 'bts', 'twice', 'stray-kids', 'newjeans', 'army', 'once', 'stay', 'bunnies'],
  payments: ['payments', 'payment', 'wowpass', 'tmoney', 't-money', 'money-saving', 'apple-pay', 'tax-refund'],
  connectivity: ['esim', 'sim', 'subway', 'transit', 'airport', 'maps', 'navigation', 'google-maps-korea'],
  beauty: ['k-beauty', 'beauty', 'clinic', 'clinics', 'medical-tourism', 'olive-young', 'skincare'],
  neighborhoods: ['hongdae', 'hannam', 'seongsu', 'gangnam', 'myeongdong', 'jongno', 'busan', 'jeju', 'yongsan', 'seongnae-dong', 'cheongdam', 'seoul-travel']
};
const categoriesFor = (post: CollectionEntry<'posts'>) => {
  const terms = new Set([...post.data.tags, post.slug].map((value) => value.toLowerCase()));
  return Object.entries(categoryMatchers)
    .filter(([, matches]) => matches.some((match) => [...terms].some((term) => term.includes(match))))
    .map(([category]) => category);
};
const categoryTabs = [
  { id: 'all', label: 'All' },
  { id: 'kpop', label: 'K-Pop & Concerts' },
  { id: 'payments', label: 'Payments & Money' },
  { id: 'connectivity', label: 'Connectivity & Transit' },
  { id: 'beauty', label: 'K-Beauty & Clinics' },
  { id: 'neighborhoods', label: 'Neighborhood Guides' }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Koursea Blog',
  url: 'https://blog.koursea.com/',
  description: 'Source-aware, field-tested guides to navigating, paying, eating and traveling across South Korea.'
};
---
<Layout title="Koursea Blog | Practical Korea Travel Guides" description="Source-aware, field-tested guides to navigating, paying, eating and traveling across South Korea." schema={schema}>
  <section class="hero shell">
    <p class="eyebrow">KOREA, WITHOUT THE GUESSWORK</p>
    <h1>Arrive informed.<br />Travel like you belong.</h1>
    <p>Detailed English guides for the decisions that matter on the ground—from map apps and subway exits to payments, clinics and local etiquette.</p>
  </section>
  <aside class="companion-banner shell" aria-labelledby="companion-title">
    <div>
      <p class="eyebrow">KOURSEA TRAVEL COMPANION</p>
      <h2 id="companion-title">Need live transit tools &amp; verified Seoul spots?</h2>
      <p>Explore 3,700+ verified locations, Korean address taxi cards, and the Zero-Login Metro Toolkit on Koursea.</p>
    </div>
    <a href="https://koursea.com">Open Koursea Travel Companion ↗</a>
  </aside>
  <section class="latest shell" aria-labelledby="latest-heading">
    <div class="section-head"><p>FIELD NOTES</p><h2 id="latest-heading">Latest practical guides</h2></div>
    <div class="category-tabs" role="tablist" aria-label="Filter guides by category">
      {categoryTabs.map((tab, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls="guide-grid" data-category={tab.id}>{tab.label}</button>
      ))}
    </div>
    <p class="filter-status" id="filter-status" aria-live="polite">Showing all {posts.length} guides</p>
    <div class="post-grid" id="guide-grid">
      {posts.map((post) => (
        <article data-categories={categoriesFor(post).join(' ')}>
          <div class="card-top"><span>{post.data.tags[0]}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
          <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <a class="read" href={`/posts/${post.slug}/`}>Read the guide <span>→</span></a>
        </article>
      ))}
    </div>
    <p class="empty-state" id="empty-state" hidden>No guides match this category yet. Explore all guides or check back soon.</p>
  </section>
</Layout>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#guide-grid > article'));
  const status = document.querySelector<HTMLElement>('#filter-status');
  const empty = document.querySelector<HTMLElement>('#empty-state');

  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const category = tab.dataset.category ?? 'all';
    let visibleCount = 0;

    tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
    cards.forEach((card) => {
      const categories = (card.dataset.categories ?? '').split(' ');
      const visible = category === 'all' || categories.includes(category);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (status) status.textContent = category === 'all'
      ? `Showing all ${visibleCount} guides`
      : `Showing ${visibleCount} ${tab.textContent?.trim() ?? ''} guides`;
    if (empty) empty.hidden = visibleCount !== 0;
  }));
</script>
<style>
  .hero{padding:100px 0 68px}.eyebrow,.section-head p{color:var(--teal);font-size:11px;font-weight:900;letter-spacing:.16em}.hero h1{max-width:860px;margin:12px 0 22px;font:700 clamp(3.4rem,9vw,7.6rem)/.9 Georgia,serif;letter-spacing:-.065em}.hero>p:last-child{max-width:680px;color:var(--muted);font-size:1.16rem}.companion-banner{display:flex;align-items:center;justify-content:space-between;gap:36px;margin-bottom:72px;padding:34px 36px;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:linear-gradient(125deg,#17213b 0%,#174f4a 72%,#247467 100%);color:#fff;box-shadow:0 24px 60px rgba(23,33,59,.2);overflow:hidden}.companion-banner>div{min-width:0}.companion-banner .eyebrow{color:#a9e2d5}.companion-banner h2{max-width:650px;margin:5px 0 10px;font:700 clamp(1.8rem,4vw,3.1rem)/1.02 Georgia,serif;letter-spacing:-.035em}.companion-banner p:last-child{max-width:650px;margin:0;color:rgba(255,255,255,.78)}.companion-banner>a{display:inline-flex;min-height:48px;flex:0 0 auto;align-items:center;justify-content:center;padding:12px 18px;border-radius:999px;background:#fff;color:var(--ink);font-size:13px;font-weight:900;text-align:center;text-decoration:none}.companion-banner>a:hover{background:var(--teal-soft)}.companion-banner>a:focus-visible{outline:3px solid #fff;outline-offset:3px}.latest{padding-bottom:40px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px;border-bottom:1px solid var(--line)}.section-head h2{margin:0 0 18px;font:700 clamp(1.8rem,4vw,3rem)/1 Georgia,serif}.category-tabs{display:flex;gap:8px;margin:0 0 10px;padding:2px 0 10px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none}.category-tabs::-webkit-scrollbar{display:none}.category-tabs button{min-height:44px;flex:0 0 auto;padding:9px 15px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);font:800 12px Inter,sans-serif;cursor:pointer;scroll-snap-align:start}.category-tabs button[aria-selected="true"]{border-color:var(--teal);background:var(--teal);color:#fff}.category-tabs button:focus-visible{outline:3px solid color-mix(in srgb,var(--teal) 35%,transparent);outline-offset:2px}.filter-status{margin:0 0 18px;color:var(--muted);font-size:12px}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.post-grid article{display:flex;min-height:330px;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.post-grid article[hidden]{display:none}.card-top{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px;text-transform:uppercase}.card-top span{color:var(--teal);font-weight:900}.post-grid h3{margin:42px 0 14px;font:700 clamp(1.8rem,4vw,2.7rem)/1.06 Georgia,serif}.post-grid h3 a{text-decoration:none}.post-grid p{margin:0;color:var(--muted)}.read{display:flex;justify-content:space-between;margin-top:auto;padding-top:24px;border-top:1px solid var(--line);font-size:13px;font-weight:850;text-decoration:none}.empty-state{padding:28px;border:1px dashed var(--line);border-radius:18px;text-align:center;color:var(--muted);background:var(--surface)}@media(max-width:700px){.hero{padding:72px 0 48px}.hero h1{font-size:clamp(3.1rem,16vw,5rem)}.companion-banner{align-items:stretch;flex-direction:column;gap:22px;margin-bottom:54px;padding:26px 22px}.companion-banner h2{font-size:clamp(1.75rem,9vw,2.35rem)}.companion-banner>a{width:100%;white-space:normal}.post-grid{grid-template-columns:1fr}.post-grid article{min-height:300px}.section-head{align-items:start;flex-direction:column;gap:0}}
</style>
