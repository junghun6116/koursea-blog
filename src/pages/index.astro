---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import beautyPages from '../data/beauty-pseo-pages.json';
import itineraryPages from '../data/itinerary-pseo-pages.json';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryMatchers = {
  kpop: ['kpop', 'concert-tickets', 'bts', 'twice', 'stray-kids', 'newjeans', 'army', 'once', 'stay', 'bunnies'],
  payments: ['payments', 'payment', 'wowpass', 'tmoney', 't-money', 'money-saving', 'apple-pay', 'tax-refund'],
  connectivity: ['esim', 'sim', 'subway', 'transit', 'airport', 'maps', 'navigation', 'google-maps-korea'],
  beauty: ['k-beauty', 'beauty', 'clinic', 'clinics', 'medical-tourism', 'olive-young', 'skincare'],
  neighborhoods: ['hongdae', 'hannam', 'seongsu', 'gangnam', 'myeongdong', 'jongno', 'busan', 'jeju', 'yongsan', 'seongnae-dong', 'cheongdam', 'seoul-travel']
};
const categoriesFor = (post: CollectionEntry<'posts'>) => {
  const terms = new Set([...post.data.tags, post.slug].map((value) => value.toLowerCase()));
  return Object.entries(categoryMatchers)
    .filter(([, matches]) => matches.some((match) => [...terms].some((term) => term.includes(match))))
    .map(([category]) => category);
};
const categoryTabs = [
  { id: 'all', label: 'All' },
  { id: 'kpop', label: 'K-Pop & Concerts' },
  { id: 'payments', label: 'Payments & Money' },
  { id: 'connectivity', label: 'Connectivity & Transit' },
  { id: 'beauty', label: 'K-Beauty & Clinics' },
  { id: 'neighborhoods', label: 'Neighborhood Guides' }
];
const bySlug = new Map<string, CollectionEntry<'posts'>>(posts.map((post) => [post.slug, post]));
const editorialCollections = [
  {
    id: 'survival', eyebrow: 'START HERE', title: 'Korea First-Timer Survival', description: 'Arrival, transit, payments and the digital tools that prevent avoidable first-day friction.', viewAll: '/?category=connectivity#latest-heading',
    items: ['seoul-subway-transit-card-guide', 'korea-payment-wowpass-vs-tmoney-applepay-2026', 'korea-esim-with-phone-number-2026-guide'].map((slug) => bySlug.get(slug)).filter(Boolean)
  },
  {
    id: 'sightseeing', eyebrow: 'SEE THE CITY', title: 'Seoul Sightseeing & Culture', description: 'Grounded routes for landmarks, seasonal events and quieter local spaces.', viewAll: 'https://www.koursea.com/guides.html?category=sightseeing-landmarks#guide-results',
    items: ['guide-seoul-local-decompress-spots-nodeul-jeongdong-namsan', 'busan-fireworks-festival-guide', 'guide-busan-subway-qr-pass-food-gamcheon-haeundae'].map((slug) => bySlug.get(slug)).filter(Boolean)
  },
  {
    id: 'shopping', eyebrow: 'SHOP SMART', title: 'Seoul Shopping & Districts', description: 'Tax-refund rules, product shortlists and efficient neighborhood shopping routes.', viewAll: 'https://www.koursea.com/guides.html?category=shopping-neighborhoods#guide-results',
    items: [
      bySlug.get('olive-young-guide-foreign-travelers'),
      bySlug.get('guide-olive-young-tax-refund-must-buy-2026'),
      { slug: 'myeongdong-route', data: { title: 'Myeongdong & Euljiro Shopping Route', description: 'A compact one-day route for cosmetics, food and central Seoul streets.', tags: ['Seoul Shopping'], pubDate: new Date('2026-08-28') }, href: '/itinerary/myeongdong-euljiro-shopping-food-itinerary/' }
    ].filter(Boolean)
  },
  {
    id: 'kpop', eyebrow: 'FAN ROUTES', title: 'K-Pop & Entertainment Routes', description: 'Agency stops, concert logistics and respectful fan itineraries built for international visitors.', viewAll: '/?category=kpop#latest-heading',
    items: ['kpop-concert-ticketing-seoul-2026', 'hybe-yongsan-1-day-tour-guide', 'sm-kwangya-seongsu-tour-guide'].map((slug) => bySlug.get(slug)).filter(Boolean)
  }
];
const collectionHref = (item: any) => item.href ?? `/posts/${item.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Koursea Blog',
  url: 'https://blog.koursea.com/',
  description: 'Source-aware, field-tested guides to navigating, paying, eating and traveling across South Korea.'
};
---
<Layout title="Koursea Blog | Practical Korea Travel Guides" description="Source-aware, field-tested guides to navigating, paying, eating and traveling across South Korea." schema={schema}>
  <section class="hero shell">
    <p class="eyebrow">KOREA, WITHOUT THE GUESSWORK</p>
    <h1>Arrive informed.<br />Travel like you belong.</h1>
    <p>Detailed English guides for the decisions that matter on the ground—from map apps and subway exits to payments, clinics and local etiquette.</p>
  </section>
  <aside class="companion-banner shell" aria-labelledby="companion-title">
    <div>
      <p class="eyebrow">KOURSEA TRAVEL COMPANION</p>
      <h2 id="companion-title">Need live transit tools &amp; verified Seoul spots?</h2>
      <p>Explore 3,806 verified locations, Korean address taxi cards, and the Zero-Login Metro Toolkit on Koursea.</p>
    </div>
    <a href="https://koursea.com">Open Koursea Travel Companion ↗</a>
  </aside>
  <section class="collections shell" aria-labelledby="collections-heading">
    <div class="section-head"><p>CURATED JOURNEYS</p><h2 id="collections-heading">Plan in the order travelers actually need</h2></div>
    <div class="collection-grid">
      {editorialCollections.map((collection) => (
        <section class="collection" aria-labelledby={`collection-${collection.id}`}>
          <div class="collection-head"><div><p>{collection.eyebrow}</p><h3 id={`collection-${collection.id}`}>{collection.title}</h3></div><a href={collection.viewAll}>View all →</a></div>
          <p class="collection-description">{collection.description}</p>
          <div class="collection-links">{collection.items.map((item: any) => <a href={collectionHref(item)}><span>{item.data.tags[0]}</span><strong>{item.data.title}</strong><small>{item.data.description}</small></a>)}</div>
        </section>
      ))}
    </div>
  </section>
  <section class="latest shell" aria-labelledby="latest-heading">
    <div class="section-head"><p>LATEST FIELD NOTES</p><h2 id="latest-heading">Latest practical guides</h2></div>
    <div class="category-tabs" role="tablist" aria-label="Filter guides by category">
      {categoryTabs.map((tab, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls="guide-grid" data-category={tab.id}>{tab.label}</button>
      ))}
    </div>
    <p class="filter-status" id="filter-status" aria-live="polite">Showing the latest {Math.min(8, posts.length)} guides</p>
    <div class="post-grid" id="guide-grid">
      {posts.map((post) => (
        <article data-categories={categoriesFor(post).join(' ')} data-default-hidden={posts.indexOf(post) >= 8 ? 'true' : 'false'} hidden={posts.indexOf(post) >= 8}>
          {post.data.coverImage && <a class="card-cover" href={`/posts/${post.slug}/`} aria-label={`Read ${post.data.title}`}><img src={post.data.coverImage} alt={`${post.data.title} guide cover`} width="1672" height="941" loading="lazy" decoding="async" /></a>}
          <div class="card-top"><span>{post.data.tags[0]}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
          <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <a class="read" href={`/posts/${post.slug}/`}>Read the guide <span>→</span></a>
        </article>
      ))}
    </div>
    <p class="empty-state" id="empty-state" hidden>No guides match this category yet. Explore all guides or check back soon.</p>
  </section>
  <section class="library shell" aria-labelledby="beauty-library-title">
    <div class="library-copy"><p class="eyebrow">{beautyPages.length} PRICE &amp; DOWNTIME GUIDES</p><h2 id="beauty-library-title">K-Beauty Treatment &amp; Price Guides</h2><p>Compare clinic models, realistic planning ranges and recovery windows before booking.</p><a href="/beauty/">Explore all K-Beauty guides →</a></div>
    <div class="library-links">{beautyPages.slice(0, 4).map((page) => <a href={`/beauty/${page.slug}/`}><span>{page.target_keyword ?? `${page.region} ${page.city}`}</span><strong>{page.treatment_name ?? page.procedureName}</strong></a>)}</div>
  </section>
  <section class="library library--route shell" aria-labelledby="itinerary-library-title">
    <div class="library-copy"><p class="eyebrow">9 FIELD-READY ROUTES</p><h2 id="itinerary-library-title">1-Day Korea Itineraries</h2><p>Follow compact routes through Seoul, Busan and Jeju without wasting time backtracking.</p><a href="/itinerary/">Explore all itineraries →</a></div>
    <div class="library-links">{itineraryPages.slice(0, 4).map((page) => <a href={`/itinerary/${page.slug}/`}><span>{page.duration}</span><strong>{page.region_name}</strong></a>)}</div>
  </section>
</Layout>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#guide-grid > article'));
  const status = document.querySelector<HTMLElement>('#filter-status');
  const empty = document.querySelector<HTMLElement>('#empty-state');

  const applyCategory = (tab: HTMLButtonElement) => {
    const category = tab.dataset.category ?? 'all';
    let visibleCount = 0;

    tabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
    cards.forEach((card) => {
      const categories = (card.dataset.categories ?? '').split(' ');
      const visible = category === 'all' ? card.dataset.defaultHidden !== 'true' : categories.includes(category);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (status) status.textContent = category === 'all'
      ? `Showing the latest ${visibleCount} guides`
      : `Showing ${visibleCount} ${tab.textContent?.trim() ?? ''} guides`;
    if (empty) empty.hidden = visibleCount !== 0;
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => applyCategory(tab)));
  const requestedCategory = new URLSearchParams(location.search).get('category');
  const requestedTab = tabs.find((tab) => tab.dataset.category === requestedCategory);
  if (requestedTab) applyCategory(requestedTab);
</script>
<style>
  .hero{padding:72px 0 42px}.eyebrow,.section-head p{color:var(--teal);font-size:11px;font-weight:900;letter-spacing:.16em}.hero h1{max-width:860px;margin:9px 0 16px;font:700 clamp(3rem,7.5vw,6.4rem)/.92 Georgia,serif;letter-spacing:-.06em}.hero>p:last-child{max-width:680px;margin:0;color:var(--muted);font-size:1.08rem}.companion-banner{display:flex;align-items:center;justify-content:space-between;gap:36px;margin-bottom:72px;padding:34px 36px;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:linear-gradient(125deg,#17213b 0%,#174f4a 72%,#247467 100%);color:#fff;box-shadow:0 24px 60px rgba(23,33,59,.2);overflow:hidden}.companion-banner>div{min-width:0}.companion-banner .eyebrow{color:#a9e2d5}.companion-banner h2{max-width:650px;margin:5px 0 10px;font:700 clamp(1.8rem,4vw,3.1rem)/1.02 Georgia,serif;letter-spacing:-.035em}.companion-banner p:last-child{max-width:650px;margin:0;color:rgba(255,255,255,.78)}.companion-banner>a{display:inline-flex;min-height:48px;flex:0 0 auto;align-items:center;justify-content:center;padding:12px 18px;border-radius:999px;background:#fff;color:var(--ink);font-size:13px;font-weight:900;text-align:center;text-decoration:none}.companion-banner>a:hover{background:var(--teal-soft)}.companion-banner>a:focus-visible{outline:3px solid #fff;outline-offset:3px}.latest{padding-bottom:40px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px;border-bottom:1px solid var(--line)}.section-head h2{margin:0 0 18px;font:700 clamp(1.8rem,4vw,3rem)/1 Georgia,serif}.category-tabs{display:flex;gap:8px;margin:0 0 10px;padding:2px 0 10px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none}.category-tabs::-webkit-scrollbar{display:none}.category-tabs button{min-height:44px;flex:0 0 auto;padding:9px 15px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);font:800 12px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;cursor:pointer;scroll-snap-align:start}.category-tabs button[aria-selected="true"]{border-color:var(--teal);background:var(--teal);color:#fff}.category-tabs button:focus-visible{outline:3px solid color-mix(in srgb,var(--teal) 35%,transparent);outline-offset:2px}.filter-status{margin:0 0 18px;color:var(--muted);font-size:12px}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.post-grid article{display:flex;min-height:330px;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.post-grid article[hidden]{display:none}.card-cover{display:block;margin:-26px -26px 22px;overflow:hidden;border-radius:20px 20px 0 0}.card-cover img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;transition:transform .35s ease}.card-cover:hover img{transform:scale(1.025)}.card-top{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px;text-transform:uppercase}.card-top span{color:var(--teal);font-weight:900}.post-grid h3{margin:42px 0 14px;font:700 clamp(1.8rem,4vw,2.7rem)/1.06 Georgia,serif}.post-grid h3 a{text-decoration:none}.post-grid p{margin:0;color:var(--muted)}.read{display:flex;justify-content:space-between;margin-top:auto;padding-top:24px;border-top:1px solid var(--line);font-size:13px;font-weight:850;text-decoration:none}.empty-state{padding:28px;border:1px dashed var(--line);border-radius:18px;text-align:center;color:var(--muted);background:var(--surface)}@media(max-width:700px){.hero{padding:34px 0 22px}.hero h1{margin:7px 0 11px;font-size:clamp(2.45rem,12.5vw,3.7rem);line-height:.94}.hero>p:last-child{font-size:.98rem;line-height:1.5}.companion-banner{align-items:stretch;flex-direction:column;gap:16px;margin-bottom:42px;padding:22px 20px}.companion-banner h2{font-size:clamp(1.6rem,8vw,2.15rem)}.companion-banner>a{width:100%;white-space:normal}.post-grid{grid-template-columns:1fr}.post-grid article{min-height:300px}.section-head{align-items:start;flex-direction:column;gap:0}}
  /* Keep the product bridge visible inside a 375 × 812 first viewport. */
  .hero{min-height:0;padding:56px 0 32px}
  .hero h1{margin:8px 0 14px;font-size:clamp(2.8rem,7vw,5.8rem)}
  .hero>p:last-child{margin:0;font-size:1.04rem}
  @media(max-width:700px){
    .hero{min-height:0!important;padding:18px 0 8px!important}
    .hero .eyebrow{margin-bottom:4px;font-size:9px}
    .hero h1{margin:4px 0 8px;font-size:clamp(2.1rem,10vw,2.75rem);line-height:.92}
    .hero>p:last-child{font-size:.9rem;line-height:1.38}
    .companion-banner{gap:10px;margin-bottom:30px;padding:12px 16px}
    .companion-banner .eyebrow{margin-bottom:2px;font-size:9px}
    .companion-banner h2{margin:2px 0 6px;font-size:1.45rem;line-height:1.02}
    .companion-banner p:last-child{font-size:.82rem;line-height:1.35}
    .companion-banner>a{min-height:44px;padding:9px 13px}
  }
  .library{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:2rem;margin-top:24px;padding:32px;border:1px solid var(--line);border-radius:24px;background:var(--surface)}.library--route{margin-top:18px;background:var(--teal-soft)}.library-copy h2{margin:.25rem 0 .8rem;font:700 clamp(1.9rem,4vw,3rem)/1 Georgia,serif;letter-spacing:-.035em}.library-copy>p:not(.eyebrow){color:var(--muted)}.library-copy>a{display:inline-block;margin-top:.5rem;color:var(--teal);font-size:.85rem;font-weight:850}.library-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.library-links a{display:flex;min-width:0;min-height:112px;flex-direction:column;justify-content:space-between;padding:1rem;border:1px solid var(--line);border-radius:14px;background:#fff;text-decoration:none}.library-links span{color:var(--teal);font-size:.68rem;font-weight:850;text-transform:uppercase}.library-links strong{font:700 1rem/1.2 Georgia,serif}
  .collections{padding:0 0 68px}.collection-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.collection{padding:24px;border:1px solid var(--line);border-radius:22px;background:var(--surface);box-shadow:var(--shadow)}.collection-head{display:flex;align-items:start;justify-content:space-between;gap:16px}.collection-head p{margin:0;color:var(--teal);font-size:10px;font-weight:900;letter-spacing:.13em}.collection-head h3{margin:4px 0 0;font:700 clamp(1.55rem,3vw,2.15rem)/1.04 Georgia,serif}.collection-head>a{display:inline-flex;min-height:44px;flex:0 0 auto;align-items:center;color:var(--teal);font-size:12px;font-weight:850}.collection-description{margin:10px 0 18px;color:var(--muted);font-size:.9rem}.collection-links{display:grid;gap:8px}.collection-links>a{display:grid;grid-template-columns:minmax(0,1fr);min-height:112px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#fff;text-decoration:none}.collection-links span{color:var(--teal);font-size:10px;font-weight:900;text-transform:uppercase}.collection-links strong{margin:5px 0;font:700 1rem/1.25 Georgia,serif}.collection-links small{color:var(--muted);line-height:1.35}
  @media(max-width:700px){.collection-grid{grid-template-columns:1fr}.collection{padding:19px}.collection-head{align-items:flex-start;flex-direction:column;gap:2px}.library{grid-template-columns:1fr;padding:20px}.library-links{grid-template-columns:1fr}.library-links a{min-height:92px}}
</style>
