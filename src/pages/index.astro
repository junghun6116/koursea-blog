---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Koursea Blog | Practical Korea Travel Guides" description="Source-aware, field-tested guides to navigating, paying, eating and traveling across South Korea.">
  <section class="hero shell">
    <p class="eyebrow">KOREA, WITHOUT THE GUESSWORK</p>
    <h1>Arrive informed.<br />Travel like you belong.</h1>
    <p>Detailed English guides for the decisions that matter on the ground—from map apps and subway exits to payments, clinics and local etiquette.</p>
  </section>
  <section class="latest shell" aria-labelledby="latest-heading">
    <div class="section-head"><p>FIELD NOTES</p><h2 id="latest-heading">Latest practical guides</h2></div>
    <div class="post-grid">
      {posts.map((post) => (
        <article>
          <div class="card-top"><span>{post.data.tags[0]}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
          <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <a class="read" href={`/posts/${post.slug}/`}>Read the guide <span>→</span></a>
        </article>
      ))}
    </div>
  </section>
</Layout>
<style>
  .hero{padding:100px 0 86px}.eyebrow,.section-head p{color:var(--teal);font-size:11px;font-weight:900;letter-spacing:.16em}.hero h1{max-width:860px;margin:12px 0 22px;font:700 clamp(3.4rem,9vw,7.6rem)/.9 Georgia,serif;letter-spacing:-.065em}.hero>p:last-child{max-width:680px;color:var(--muted);font-size:1.16rem}.latest{padding-bottom:40px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px;border-bottom:1px solid var(--line)}.section-head h2{margin:0 0 18px;font:700 clamp(1.8rem,4vw,3rem)/1 Georgia,serif}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.post-grid article{display:flex;min-height:330px;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.card-top{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px;text-transform:uppercase}.card-top span{color:var(--teal);font-weight:900}.post-grid h3{margin:42px 0 14px;font:700 clamp(1.8rem,4vw,2.7rem)/1.06 Georgia,serif}.post-grid h3 a{text-decoration:none}.post-grid p{margin:0;color:var(--muted)}.read{display:flex;justify-content:space-between;margin-top:auto;padding-top:24px;border-top:1px solid var(--line);font-size:13px;font-weight:850;text-decoration:none}@media(max-width:700px){.hero{padding:72px 0 58px}.hero h1{font-size:clamp(3.1rem,16vw,5rem)}.post-grid{grid-template-columns:1fr}.post-grid article{min-height:300px}.section-head{align-items:start;flex-direction:column;gap:0}}
</style>
