---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { categoryHubs, categoriesForTags, categoryForSlug } from '../../lib/category-hubs';

export async function getStaticPaths() {
  return categoryHubs.map((hub) => ({ params: { slug: hub.slug } }));
}

const slug = Astro.params.slug ?? '';
const hub = categoryForSlug(slug);
if (!hub) return Astro.redirect('/category/');
const posts = (await getCollection('posts'))
  .filter((post) => categoriesForTags(post.data.tags).some((category) => category.slug === hub.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const canonicalUrl = new URL(`/category/${hub.slug}/`, Astro.site).href;
const isKpopHub = hub.slug === 'kpop';
const kpopCampaign = 'utm_source=koursea_blog&utm_medium=referral&utm_campaign=kpop_fan_travel';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${hub.label} Guides`,
  description: hub.description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/posts/${post.id}/`, Astro.site).href,
      name: post.data.title
    }))
  }
};
---
<Layout title={`${hub.label} Guides | Koursea Blog`} description={hub.description} canonicalUrl={canonicalUrl} schema={schema}>
  <section class="category-page shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Journal</a><span aria-hidden="true">/</span><a href="/category/">Categories</a><span aria-hidden="true">/</span><span>{hub.label}</span></nav>
    <header><p class="eyebrow">{posts.length} PUBLISHED GUIDES</p><h1>{hub.label}</h1><p>{hub.description}</p></header>
    {isKpopHub && <aside class="kpop-handoff" aria-label="K-pop fan travel planning">
      <div><span>FROM READING TO A REAL ROUTE</span><strong>Plan the concert day, then add verified fan stops.</strong><p>Move from Koursea Journal into venue transport, official shopping, source-checked places and K-pop questions.</p></div>
      <div class="kpop-handoff__actions"><a href={`https://www.koursea.com/kpop.html?${kpopCampaign}&utm_content=category_hub`} data-kpop-category-cta="hub">Start the fan-travel plan ↗</a><a href={`https://www.koursea.com/community.html?topic=kpop_concerts&compose=1&${kpopCampaign}&utm_content=category_ask`} data-kpop-category-cta="ask">Ask Koursea ↗</a></div>
    </aside>}
    <nav class="category-switcher" aria-label="Guide categories">{categoryHubs.map((category) => <a class:list={{ active: category.slug === hub.slug }} href={`/category/${category.slug}/`}>{category.label}</a>)}</nav>
    <div class="post-grid">
      {posts.map((post, index) => <GuideCard href={`/posts/${post.id}/`} title={post.data.title} description={post.data.description} label={post.data.category ?? post.data.tags[0] ?? hub.label} date={post.data.updatedDate ?? post.data.pubDate} image={post.data.coverImage} imageAlt={post.data.coverImageAlt ?? `${post.data.title} guide cover`} featured={index === 0 && Boolean(post.data.coverImage)} />)}
    </div>
  </section>
  {isKpopHub && <script is:inline>
    document.querySelectorAll('[data-kpop-category-cta]').forEach((link) => {
      link.addEventListener('click', () => {
        if (typeof window.gtag !== 'function') return;
        window.gtag('event', 'kpop_blog_category_cta_click', {
          destination: link.getAttribute('data-kpop-category-cta') || 'unknown'
        });
      });
    });
  </script>}
</Layout>

<style>
  .category-page{padding:72px 0}.breadcrumbs{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:2rem;color:var(--muted);font-size:.78rem;font-weight:750}.breadcrumbs a{color:var(--teal)}header{padding-bottom:24px;border-bottom:1px solid var(--ink)}header h1{max-width:15ch;margin:.25rem 0 1rem;font:700 clamp(2.7rem,7vw,5.2rem)/.96 var(--font-display);letter-spacing:-.05em}header>p:last-child{max-width:700px;color:var(--muted);font-size:1.08rem}.kpop-handoff{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;margin:32px 0;padding:28px;border-radius:4px 28px 4px 4px;background:var(--ink);color:#fff;box-shadow:var(--shadow)}.kpop-handoff span{font-size:.68rem;font-weight:900;letter-spacing:.1em;color:#b7ddd8}.kpop-handoff strong{display:block;max-width:22ch;margin:.5rem 0;font:700 clamp(1.45rem,3vw,2.15rem)/1.08 var(--font-display)}.kpop-handoff p{max-width:650px;margin:0;color:#d7e9e7}.kpop-handoff__actions{display:flex;flex-wrap:wrap;gap:8px}.kpop-handoff__actions a{display:inline-flex;align-items:center;min-height:44px;padding:11px 15px;border-radius:999px;background:#fff;color:var(--ink);font-size:.78rem;font-weight:900;text-decoration:none}.kpop-handoff__actions a:last-child{border:1px solid #7bbab3;background:transparent;color:#fff}.category-switcher{display:flex;gap:8px;margin:36px 0 24px;overflow-x:auto}.category-switcher a{flex:0 0 auto;padding:10px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:.78rem;font-weight:850;text-decoration:none}.category-switcher a.active{border-color:var(--teal);background:var(--teal);color:#fff}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}@media(max-width:700px){.category-page{padding:46px 0}.kpop-handoff{grid-template-columns:1fr;padding:20px}.kpop-handoff__actions{flex-direction:column}.kpop-handoff__actions a{justify-content:center}.post-grid{grid-template-columns:1fr}}
</style>
