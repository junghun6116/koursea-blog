---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categoryHubs, categoriesForTags } from '../../lib/category-hubs';

const posts = await getCollection('posts');
const hubs = categoryHubs.map((hub) => ({
  ...hub,
  count: posts.filter((post) => categoriesForTags(post.data.tags).some((category) => category.slug === hub.slug)).length
}));
---
<Layout title="Guide Categories | Koursea Blog" description="Browse Koursea travel guides by K-Pop, healthcare and practical travel topics.">
  <section class="category-page shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Journal</a><span aria-hidden="true">/</span><span>Categories</span></nav>
    <p class="eyebrow">GUIDE LIBRARY</p>
    <h1>Browse by category</h1>
    <p class="intro">Explore the existing Koursea guide library through categories derived from each post's published tags.</p>
    <div class="hub-grid">
      {hubs.map((hub) => <a href={`/category/${hub.slug}/`}><span>{hub.count} guides</span><strong>{hub.label}</strong><p>{hub.description}</p><small>Open category →</small></a>)}
    </div>
  </section>
</Layout>

<style>
  .category-page{padding:72px 0}.breadcrumbs{display:flex;gap:.45rem;margin-bottom:2rem;color:var(--muted);font-size:.78rem;font-weight:750}.breadcrumbs a{color:var(--teal)}h1{max-width:12ch;margin:.25rem 0 1rem;font:700 clamp(2.7rem,7vw,5.2rem)/.96 Georgia,serif;letter-spacing:-.05em}.intro{max-width:680px;color:var(--muted);font-size:1.08rem}.hub-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:42px}.hub-grid>a{display:flex;min-height:300px;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow);text-decoration:none}.hub-grid span{color:var(--teal);font-size:.72rem;font-weight:900;text-transform:uppercase}.hub-grid strong{margin:2rem 0 .8rem;font:700 1.8rem/1.05 Georgia,serif}.hub-grid p{margin:0;color:var(--muted)}.hub-grid small{margin-top:auto;padding-top:2rem;color:var(--teal);font-weight:850}@media(max-width:760px){.category-page{padding:46px 0}.hub-grid{grid-template-columns:1fr}.hub-grid>a{min-height:230px}}
</style>
