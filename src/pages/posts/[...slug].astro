---
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import PostLayout from '../../layouts/PostLayout.astro';
import beautyPages from '../../data/beauty-pseo-pages.json';
import itineraryPages from '../../data/itinerary-pseo-pages.json';
import relatedMap from '../../data/post-related-pseo.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const allPosts = await getCollection('posts');
const { Content, headings } = await render(post);
const canonicalUrl = post.data.canonicalUrl ?? new URL(`/posts/${post.id}/`, Astro.site).href;
const author = post.data.author ?? 'Koursea Editorial';
const wordCount = ((post.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/https?:\/\/\S+/g, ' ')
  .replace(/<[^>]+>|[#>*_`|\[\]()-]/g, ' ')
  .match(/[\p{L}\p{N}][\p{L}\p{N}'’.-]*/gu) ?? []).length;
const hiddenHeadings = new Set([
  'Social & Community Distribution Snippets',
  'Threads & X (Twitter) Hook',
  'Reddit Community Reply Template'
]);
const toc = headings.filter(
  (heading: MarkdownHeading) => (heading.depth === 2 || heading.depth === 3) && !hiddenHeadings.has(heading.text)
);
const mapped = relatedMap[post.id as keyof typeof relatedMap];
const relatedBeauty = (mapped?.beauty ?? []).flatMap((slug) => {
  const page = beautyPages.find((item) => item.slug === slug);
  return page ? [{ href: `/beauty/${page.slug}/`, title: page.treatment_name ?? page.procedureName ?? 'K-Beauty planning guide', eyebrow: 'PRICE & DOWNTIME' }] : [];
});
const relatedItineraries = (mapped?.itinerary ?? []).flatMap((slug) => {
  const page = itineraryPages.find((item) => item.slug === slug);
  return page ? [{ href: `/itinerary/${page.slug}/`, title: `${page.region_name} ${page.duration}`, eyebrow: '1-DAY ROUTE' }] : [];
});
const kpopPattern = /k-?pop|concert|fandom|fan guide|photocard|music show|kspo|hybe|jyp|\bsm\b|\byg\b/i;
const isKpopPost = kpopPattern.test(`${post.data.title} ${(post.data.tags ?? []).join(' ')}`);
const postContext = `${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`.toLowerCase();
const titleStopWords = new Set(['guide', 'kpop', 'seoul', 'korea', 'foreigner', 'foreigners', 'travel', '2026']);
const titleTerms = new Set((post.data.title.toLowerCase().match(/[a-z0-9]{4,}/g) ?? []).filter((term) => !titleStopWords.has(term)));
const relatedIntentPatterns = [
  /ticket|concert|music show|venue|kspo|performance/,
  /merch|album|photocard|lucky draw|shopping/,
  /fan guide|fandom|agency|hybe|jyp|\bsm\b|\byg\b/
];
const activeIntentIndex = relatedIntentPatterns.findIndex((pattern) => pattern.test(postContext));
const intentTitleScore = [
  (candidateTitle: string) => /ticket|music show|venue|kspo|concert day/.test(candidateTitle) ? 30 : /concert|performance/.test(candidateTitle) ? 10 : 0,
  (candidateTitle: string) => /merch|album|photocard|lucky draw|shopping/.test(candidateTitle) ? 30 : 0,
  (candidateTitle: string) => /fan guide|agency|hybe|jyp|\bsm\b|\byg\b/.test(candidateTitle) ? 30 : 0
];
const relatedKpop = isKpopPost
  ? allPosts
      .filter((candidate) => candidate.id !== post.id && kpopPattern.test(`${candidate.data.title} ${(candidate.data.tags ?? []).join(' ')}`))
      .map((candidate) => {
        const candidateTerms = candidate.data.title.toLowerCase().match(/[a-z0-9]{4,}/g) ?? [];
        const sharedTags = (candidate.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag)).length;
        const sharedTitleTerms = candidateTerms.filter((term) => titleTerms.has(term)).length;
        const intentMatch = activeIntentIndex >= 0 ? intentTitleScore[activeIntentIndex](candidate.data.title.toLowerCase()) : 0;
        return { candidate, score: intentMatch + sharedTags * 3 + sharedTitleTerms };
      })
      .sort((a, b) => b.score - a.score || b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf())
      .slice(0, 4)
      .map(({ candidate }) => ({
        href: `/posts/${candidate.id}/`,
        title: candidate.data.title,
        eyebrow: 'K-POP & FAN TRAVEL'
      }))
  : [];
const socialEmbeds: Record<string, { xUrl?: string; instagramUrl?: string; label: string }> = {
  'bts-fan-guide-hybe-yongsan': {
    xUrl: 'https://x.com/bts_bighit/status/2021932587661635731',
    label: 'Official BTS world tour update from @bts_bighit'
  },
  'twice-fan-guide-jyp-cheongdam': {
    xUrl: 'https://x.com/JYPETWICE/status/1858377141957935385',
    label: 'Official TWICE update from @JYPETWICE'
  },
  'stray-kids-fan-guide-jyp-cheongdam': {
    xUrl: 'https://x.com/Stray_Kids/status/1804152326279827516',
    label: 'Official Stray Kids activity update from @Stray_Kids'
  },
  'newjeans-fan-guide-seoul-spots': {
    xUrl: 'https://x.com/NewJeans_ADOR/status/1793899770244943967',
    label: 'Official NewJeans activity update from @NewJeans_ADOR'
  },
  'seventeen-fan-guide-seoul-spots': {
    xUrl: 'https://x.com/pledis_17/status/1681650098554433537',
    label: 'Official SEVENTEEN activity update from @pledis_17'
  },
  'enhypen-fan-guide-seoul-spots': {
    xUrl: 'https://x.com/ENHYPEN/status/1998589863118229822',
    label: 'Official ENHYPEN Seoul pop-up update from @ENHYPEN'
  },
  'aespa-fan-guide-seoul-spots': {
    xUrl: 'https://x.com/aespa_official/status/1817077790564622699',
    label: 'Official aespa activity update from @aespa_official'
  },
  'free-things-to-do-seoul-busan-jongno-exhibitions': {
    instagramUrl: 'https://www.instagram.com/p/Dcm14v-I_x-/',
    label: 'September 2026 Jongno exhibition roundup by @seochoneditor'
  }
};
const socialEmbed = socialEmbeds[post.id];
const editorialCallouts: Record<string, {
  badge: string;
  title: string;
  description: string;
  buttonText: string;
  href: string;
  metadata: Array<{ label: string; value: string }>;
}> = {
  'korea-payment-wowpass-vs-tmoney-applepay-2026': {
    badge: 'TRANSPARENT PRICING',
    title: 'Foreigner-Friendly Skin Clinics with Direct Card Payment',
    description: 'No hidden agency surcharges. Pay official local rates directly with Visa, Mastercard, or AMEX at verified English-speaking clinics.',
    buttonText: 'Browse Verified Clinics',
    href: '/beauty/',
    metadata: [
      { label: 'English Support', value: 'Verified' },
      { label: 'Payment', value: 'Direct Card Accepted' },
      { label: 'Areas', value: 'Gangnam · Hongdae' }
    ]
  },
  'first-24-hours-in-seoul-survival-guide': {
    badge: 'POST-FLIGHT CARE',
    title: 'Zero-Downtime Jet Lag & Skin Recovery in Seoul',
    description: 'Combat in-flight dehydration with instant soothing, LDM hydration, and recovery drips along AREX subway lines.',
    buttonText: 'Explore Recovery Treatments',
    href: '/beauty/',
    metadata: [
      { label: 'Typical Downtime', value: '0–1 day' },
      { label: 'Transit', value: 'Near AREX routes' }
    ]
  }
};
const editorialCallout = editorialCallouts[post.id];
// Editorial covers stay authoritative. Every other post receives a stable,
// title-specific 1200x630 image generated during prebuild instead of sharing
// the generic site fallback.
const socialImage = post.data.coverImage ?? post.data.thumbnail ?? `/og/posts/${post.id}.png`;
---
<PostLayout title={post.data.title} description={post.data.description} category={post.data.category} canonicalUrl={canonicalUrl} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} author={author} reviewer={post.data.reviewer} tags={post.data.tags} socialImage={socialImage} socialImageAlt={`${post.data.title} — Koursea Journal`} coverImage={post.data.coverImage} wordCount={wordCount} toc={toc} relatedGuides={isKpopPost ? relatedKpop : [...relatedBeauty, ...relatedItineraries]} socialEmbed={socialEmbed} faq={post.data.faq} editorialCallout={editorialCallout}>
  <Content />
</PostLayout>
