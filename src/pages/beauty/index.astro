---
import Layout from '../../layouts/Layout.astro';
import beautyPages from '../../data/beauty-pseo-pages.json';

type BeautyPage = (typeof beautyPages)[number];
const groups: Array<{ title: string; description: string; test: (page: BeautyPage) => boolean }> = [
  { title: 'Skin Texture', description: 'Microneedling and laser guides for texture, pores and pigmentation.', test: (page) => /potenza|laser-toning/.test(page.slug) },
  { title: 'Lifting Devices', description: 'Compare Ultherapy Prime, Shurink Universe and HIFU planning ranges.', test: (page) => /ultherapy|shurink/.test(page.slug) },
  { title: 'Injections', description: 'Dose-aware planning for Rejuran, Botox and dermal fillers.', test: (page) => /rejuran|botox|filler/.test(page.slug) },
  { title: 'Booking Tips', description: 'VAT-inclusive quotes, payment safeguards and pre-booking checks.', test: (page) => /vat-inclusion|cash-discount/.test(page.slug) }
];
const groupedPages = groups.map((group) => ({ ...group, pages: beautyPages.filter(group.test) }));
const canonicalUrl = new URL('/beauty/', Astro.site).href;
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'CollectionPage', name: 'K-Beauty Treatment & Price Guides', description: 'Practical price, downtime and booking comparisons for cosmetic treatments in Seoul.', url: canonicalUrl },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Beauty Guides', item: canonicalUrl }
  ] }
] };
---
<Layout title="K-Beauty Treatment & Price Guides | Koursea Blog" description="Compare Seoul K-beauty treatment prices, clinic models, downtime and booking checks across 15 practical guides." canonicalUrl={canonicalUrl} schema={schema}>
  <main class="hub shell">
    <header class="hub-hero"><p class="eyebrow">K-BEAUTY PLANNING LIBRARY</p><h1>K-Beauty Treatment &amp; Price Guides</h1><p>Compare the same treatment, dose and clinic model before you book. These guides focus on realistic planning ranges, recovery time and questions international visitors should ask.</p></header>
    <nav class="jump-nav" aria-label="Beauty guide categories">{groupedPages.map((group) => <a href={`#${group.title.toLowerCase().replaceAll(' ', '-')}`}>{group.title} <span>{group.pages.length}</span></a>)}</nav>
    {groupedPages.map((group) => <section id={group.title.toLowerCase().replaceAll(' ', '-')} class="guide-group">
      <div class="section-heading"><div><p class="eyebrow">{group.pages.length} GUIDES</p><h2>{group.title}</h2></div><p>{group.description}</p></div>
      <div class="guide-grid">{group.pages.map((page) => <article><p class="keyword">{page.target_keyword}</p><h3><a href={`/beauty/${page.slug}/`}>{page.treatment_name}</a></h3><p>{page.clinic_type}</p><a class="read" href={`/beauty/${page.slug}/`}>Compare price &amp; downtime →</a></article>)}</div>
    </section>)}
  </main>
</Layout>
<style>
  .hub{padding:72px 0}.hub-hero{max-width:780px}.hub h1{margin:.3rem 0 1rem;font:700 clamp(2.7rem,7vw,5.4rem)/.96 Georgia,serif;letter-spacing:-.05em}.hub-hero>p:last-child{max-width:68ch;color:var(--muted);font-size:1.08rem}.jump-nav{display:flex;gap:.6rem;margin:2rem 0 4rem;overflow-x:auto;scrollbar-width:none}.jump-nav a{display:flex;min-height:44px;flex:0 0 auto;align-items:center;gap:.55rem;padding:.65rem .9rem;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:.82rem;font-weight:800;text-decoration:none}.jump-nav span{color:var(--teal)}.guide-group{margin-top:4rem;scroll-margin-top:90px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-bottom:1rem;border-bottom:1px solid var(--line)}.section-heading h2{margin:0;font:700 clamp(1.9rem,4vw,2.8rem)/1 Georgia,serif}.section-heading>p{max-width:48ch;margin:0;color:var(--muted)}.guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.25rem}.guide-grid article{display:flex;min-height:245px;flex-direction:column;padding:1.4rem;border:1px solid var(--line);border-radius:18px;background:var(--surface)}.keyword{margin:0;color:var(--teal);font-size:.72rem;font-weight:850;text-transform:uppercase}.guide-grid h3{margin:1.2rem 0 .7rem;font:700 1.45rem/1.12 Georgia,serif}.guide-grid h3 a,.read{text-decoration:none}.guide-grid article>p:not(.keyword){margin:0;color:var(--muted);font-size:.9rem}.read{margin-top:auto;padding-top:1.2rem;color:var(--teal);font-size:.82rem;font-weight:850}@media(max-width:650px){.hub{padding:46px 0}.jump-nav{margin-bottom:2.6rem}.guide-group{margin-top:3rem}.section-heading{align-items:start;flex-direction:column;gap:.6rem}.guide-grid{grid-template-columns:1fr}.guide-grid article{min-height:210px}}
</style>
