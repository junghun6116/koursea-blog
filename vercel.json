{
  "headers": [
    {
      "source": "/guides_index.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-default.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-default.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/posts/guide-korea-esim-sim-card-setup-2026/",
      "headers": {
        "Location": "/posts/korea-esim-with-phone-number-2026-guide/"
      },
      "status": 301
    },
    {
      "src": "/posts/guide-how-to-pay-in-korea-convenience-stores-global-atm-2026/",
      "headers": {
        "Location": "https://www.koursea.com/guide-how-to-pay-in-korea-convenience-stores-global-atm-2026.html"
      },
      "status": 301
    },
    {
      "src": "/posts/guide-seoul-climate-card-tourist-pass/",
      "headers": {
        "Location": "https://www.koursea.com/guide-seoul-climate-card-tourist-pass.html"
      },
      "status": 301
    },
    {
      "src": "/wowpass-card-currency-exchange-t-money-cashless-guide\\.html",
      "headers": {
        "Location": "/posts/korea-payment-wowpass-vs-tmoney-applepay-2026/"
      },
      "status": 301
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
